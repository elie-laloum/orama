{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orama",
  "mainBinaryName": "orama-desktop",
  "version": "0.1.0",
  "identifier": "com.elielaloum.orama",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run build:web",
    "beforeDevCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local proxy and dashboard for coding-agent traffic.",
    "longDescription": "Orama sits between a coding-agent CLI and its model provider, captures every round trip to a local SQLite file, and serves a dashboard over the result. Nothing leaves the machine.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
