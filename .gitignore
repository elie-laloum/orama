# --- Rust / Cargo ---------------------------------------------------------
/target
**/*.rs.bk
*.pdb

# --- Capture databases ----------------------------------------------------
# The proxy stores verbatim request/response bodies. Never commit them.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

# --- Node / frontend ------------------------------------------------------
node_modules/
apps/web/dist/
*.tsbuildinfo
.npm/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Tauri desktop shell --------------------------------------------------
# Regenerated by tauri-build on every compile from tauri.conf.json and the
# plugin set. Committing it means a diff on every build for a file nobody
# edits. The icons next to it are NOT generated per build and are committed,
# so a release runner does not need Pillow to make an installer.
apps/desktop/src-tauri/gen/schemas/

# --- Secrets & local config ----------------------------------------------
.env
.env.*
!.env.example
# Local agent settings may contain API keys
.claude/settings.local.json
.mise.local.toml

# --- Coverage / profiling -------------------------------------------------
coverage/
lcov.info
*.profraw
*.profdata

# --- Editors & OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
